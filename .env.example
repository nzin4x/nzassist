# nzassist — copy to .env and fill in. .env is gitignored.

# --- Todoist (마이그레이션 1회용, 완료 후 폐기) ---
TODOIST_API_TOKEN=

# --- Google OAuth (Calendar. 개인 계정이라 서비스 계정 불가) ---
# 운영 로그인은 반드시 "웹 애플리케이션" 유형 OAuth 클라이언트를 사용한다.
# 아래 callback URL을 Google Cloud의 승인된 리디렉션 URI에 정확히 등록한다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 로컬 1회용 refresh token 경로에서만 사용한다. 운영 웹 로그인은 세션을 사용한다.
GOOGLE_OAUTH_REFRESH_TOKEN=
# Web OAuth settings. Redirect URI must exactly match the Google Cloud OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=https://assist.nz.pe.kr/auth/google/callback
OAUTH_SESSION_SECRET=
API_PUBLIC_URL=https://l4e3dtacfzcaaexcdlhfqln3qy0gdfpf.lambda-url.ap-northeast-2.on.aws

# --- Cloudflare Pages ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- AWS ---
AWS_REGION=ap-northeast-2
DDB_SETTINGS_TABLE=nzassist-settings

# --- defaults (DynamoDB 설정으로 덮어쓰기 가능) ---
DEFAULT_TZ=Asia/Seoul
DEFAULT_DUE_TIME=09:00
NORMALIZER_INTERVAL_MIN=60

# --- PWA ---
# 완료 링크(D8)에 쓰이는 배포 도메인. 예: https://assist.nz.pe.kr
PWA_BASE_URL=
# Legacy fallback only. Production frontend does not embed this token.
API_TOKEN=
GITHUB_TOKEN=
