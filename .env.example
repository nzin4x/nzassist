# nzassist — copy to .env and fill in. .env is gitignored.

# --- Todoist (마이그레이션 1회용, 완료 후 폐기) ---
TODOIST_API_TOKEN=

# --- Google OAuth (Calendar. 개인 계정이라 서비스 계정 불가) ---
# 데스크톱 앱 유형. 리디렉션 URI에 http://127.0.0.1:53682/callback 등록 필요
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Cloudflare Pages ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- AWS ---
AWS_REGION=ap-northeast-2
DDB_SETTINGS_TABLE=nzassist-settings

# --- defaults (DynamoDB 설정으로 덮어쓰기 가능) ---
DEFAULT_TZ=Asia/Seoul
DEFAULT_DUE_TIME=09:00
NORMALIZER_INTERVAL_MIN=60

# --- PWA ---
# 완료 링크(D8)에 쓰이는 배포 도메인. 예: https://nzassist.pages.dev
PWA_BASE_URL=
# PWA -> API 접근용 고정 토큰 (아무 랜덤 문자열)
API_TOKEN=
GITHUB_TOKEN=
